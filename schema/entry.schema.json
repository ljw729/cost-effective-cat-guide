{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cost-effective-cat-guide/schema/entry.schema.json",
  "title": "Guide entry",
  "description": "One piece of guidance. The single source of truth for README, website, PDF, EPUB and the AI skill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "slug", "type", "title", "summary", "category", "tags", "recommendation",
    "why_it_matters", "applies_to", "urgency", "scores", "evidence",
    "medical_review_required", "review_status", "created", "last_reviewed", "sources"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CG-[0-9]{4}$", "description": "Stable id. Never reused, never changed." },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "type": { "enum": ["recommendation", "dont", "buying_guide", "emergency", "myth", "evidence_gap"] },
    "title": { "type": "string", "minLength": 4, "maxLength": 60 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 140, "description": "一句话结论" },
    "category": { "type": "string" },
    "subcategory": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "minItems": 1, "uniqueItems": true },
    "recommendation": { "type": "string", "minLength": 10 },
    "why_it_matters": { "type": "string", "minLength": 10 },
    "how_to_do_it": { "type": "array", "items": { "type": "string" } },
    "exceptions": { "type": "array", "items": { "type": "string" } },
    "warning_signs": { "type": "array", "items": { "type": "string" } },
    "emergency_action": {
      "type": "array", "items": { "type": "string" }, "minItems": 1,
      "description": "For emergency entries: what to do right now. Never home treatment, never drug doses."
    },
    "do_not": { "type": "array", "items": { "type": "string" }, "description": "Common wrong actions to avoid." },
    "applies_to": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["all", "kitten", "adult", "senior", "indoor", "outdoor", "multi-cat", "male", "special-condition"] }
    },
    "urgency": { "enum": ["routine", "important", "urgent", "emergency"] },
    "region_notes": { "type": "string", "description": "When advice differs by country/region/lifestyle." },
    "myth_claim": { "type": "string" },
    "myth_verdict": { "enum": ["incorrect", "mostly_incorrect", "uncertain", "partly_correct", "correct"], "description": "Words, not booleans: YAML would parse true/false." },
    "myth_related": { "type": "array", "items": { "type": "string", "pattern": "^CG-[0-9]{4}$" } },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^CG-[0-9]{4}$" } },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["benefit", "risk_reduction", "money_cost", "time_cost", "effort", "harm_potential"],
      "properties": {
        "benefit": { "type": "integer", "minimum": 1, "maximum": 5 },
        "risk_reduction": { "type": "integer", "minimum": 1, "maximum": 5 },
        "money_cost": { "type": "integer", "minimum": 0, "maximum": 5 },
        "time_cost": { "type": "integer", "minimum": 1, "maximum": 5 },
        "effort": { "type": "integer", "minimum": 1, "maximum": 5 },
        "harm_potential": { "type": "integer", "minimum": 0, "maximum": 3 },
        "rationale": { "type": "string", "description": "Why these numbers." }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "summary"],
      "properties": {
        "level": { "enum": ["A", "B", "C", "D"] },
        "summary": { "type": "string", "minLength": 20 },
        "conflict": { "type": "boolean" },
        "conflict_notes": {
          "type": "object", "additionalProperties": false,
          "required": ["positions", "current_interpretation"],
          "properties": {
            "positions": {
              "type": "array", "minItems": 2,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["position", "sources"],
                "properties": { "position": { "type": "string" }, "sources": { "type": "array", "items": { "type": "string" } } }
              }
            },
            "current_interpretation": { "type": "string" }
          }
        },
        "gaps": { "type": "array", "items": { "type": "string" }, "description": "What is still unknown / TODO / NEED REVIEW." }
      }
    },
    "medical_review_required": { "type": "boolean" },
    "review_status": { "enum": ["draft", "ai_researched", "maintainer_reviewed", "vet_reviewed"] },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object", "required": ["role", "date"],
        "properties": { "name": { "type": "string" }, "role": { "enum": ["ai", "maintainer", "veterinarian"] }, "credentials": { "type": "string" }, "date": { "type": "string", "format": "date" } }
      }
    },
    "created": { "type": "string", "format": "date" },
    "last_reviewed": { "type": "string", "format": "date" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "supports", "support_check"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "supports": { "type": "string", "minLength": 10, "description": "What exactly this source supports, in our own words." },
          "support_check": { "enum": ["pending", "ai_checked", "human_checked", "vet_checked"] },
          "locator": { "type": "string", "description": "Section / table / page where the support is found." }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "emergency" } } },
      "then": { "required": ["emergency_action", "warning_signs"], "properties": { "urgency": { "const": "emergency" } } } },
    { "if": { "properties": { "type": { "const": "myth" } } },
      "then": { "required": ["myth_claim", "myth_verdict"] } }
  ],
  "$comment": "evidence.conflict=true requires evidence.conflict_notes — enforced in src/validate.ts (rule: evidence-conflict)."
}
