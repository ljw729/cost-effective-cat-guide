{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cost-effective-cat-guide/schema/source.schema.json",
  "title": "Source registry",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "organization", "year", "source_type", "tier", "url", "accessed", "verification"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 5 },
      "organization": { "type": "string", "description": "Publishing body or journal publisher / guideline owner." },
      "authors": { "type": "array", "items": { "type": "string" }, "description": "Family names; first author first." },
      "year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
      "container": { "type": "string", "description": "Journal or website name." },
      "doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$" },
      "pmid": { "type": "string", "pattern": "^[0-9]+$" },
      "pmcid": { "type": "string", "pattern": "^PMC[0-9]+$" },
      "url": { "type": "string", "format": "uri" },
      "archive_url": { "type": "string", "format": "uri" },
      "source_type": {
        "enum": ["systematic_review", "meta_analysis", "guideline", "consensus_statement", "rct", "cohort",
                 "case_control", "cross_sectional", "case_series", "experimental", "narrative_review",
                 "government", "organization_page", "textbook"]
      },
      "tier": { "enum": [1, 2] },
      "sample_size": { "type": "string" },
      "conflict_of_interest": { "type": "string" },
      "accessed": { "type": "string", "format": "date" },
      "superseded_by": { "type": "string" },
      "notes": { "type": "string" },
      "verification": {
        "type": "object", "additionalProperties": false,
        "required": ["exists", "metadata_match", "read_level", "checked"],
        "properties": {
          "exists": { "type": "boolean" },
          "metadata_match": { "type": "boolean" },
          "read_level": { "enum": ["full_text", "abstract", "page", "metadata_only"] },
          "checked": { "type": "string", "format": "date" },
          "method": { "type": "string" }
        }
      }
    }
  }
}
